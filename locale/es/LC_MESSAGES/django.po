msgstr "Abriendo el admin del Hub…"

#: accounts/admin.py
#: accounts/templates/admin/accounts/hubmembership/change_list.html
msgid "Hubs"
msgstr "Hubs"

#: accounts/templates/admin/accounts/hubs.html
msgid "Hub"
msgstr "Hub"

