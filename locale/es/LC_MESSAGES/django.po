msgstr "correo nuevo"

msgid "attempts"
msgstr "intentos"

msgid "change of email"
msgstr "cambio de correo"

msgid "changes of email"
msgstr "cambios de correo"

msgid "Not found."
msgstr "No encontrado."

msgid "Your account has no password yet: set one with «Forgot your password?»."
msgstr "Tu cuenta aún no tiene contraseña: crea una con «¿Has olvidado tu contraseña?»."

msgid "New API key in your ERPlora account"
msgstr "Nueva clave de API en tu cuenta de ERPlora"

msgid "An API key called «%(name)s» was created in your ERPlora account, with these permissions: %(scopes)s."
msgstr "Se ha creado en tu cuenta de ERPlora una clave de API llamada «%(name)s», con estos permisos: %(scopes)s."

msgid "If you did not create it, revoke it in Account → API keys and write to %(support)s at once."
msgstr "Si no la has creado tú, revócala en Cuenta → Claves de API y escribe cuanto antes a %(support)s."

msgid "You pay for businesses of other people: ask their owner to enter their own payment details before deleting your account."
msgstr "Pagas negocios de otras personas: pide a su propietario que ponga sus datos de pago antes de eliminar tu cuenta."

msgid "expires"
msgstr "caduca"

msgid "In 90 days"
msgstr "En 90 días"

msgid "In 30 days"
msgstr "En 30 días"

msgid "Never"
msgstr "Nunca"

msgid "Team accounts only: a customer creates its own keys in Account › API keys."
msgstr "Solo cuentas del equipo: un cliente crea sus propias claves en Cuenta › Claves de API."

msgid "API key issued"
msgstr "Clave de API emitida"

msgid "API keys are issued here for team accounts only."
msgstr "Aquí solo se emiten claves de API para cuentas del equipo."

msgid "The key «%(name)s» of %(email)s is ready. Copy it now: it will not be shown again."
msgstr "La clave «%(name)s» de %(email)s está lista. Cópiala ahora: no se volverá a mostrar."

msgid "Its owner was told by email. If it gets lost, revoke it and issue another one."
msgstr "Se ha avisado a su titular por correo. Si se pierde, revócala y emite otra."

msgid "Back to the API keys"
msgstr "Volver a las claves de API"

msgid "We could not load the API documentation. Reload the page to try again."
msgstr "No hemos podido cargar la documentación de la API. Recarga la página para volver a intentarlo."

