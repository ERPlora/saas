#: admin.py:82
msgid "Meta's permission"
msgstr "Permiso de Meta"

#: admin.py:85
msgid "Missing: the business has to connect the number again."
msgstr "Falta: el negocio tiene que volver a conectar el número."

#: admin.py:87
msgid "Expired: the business has to connect the number again."
msgstr "Caducado: el negocio tiene que volver a conectar el número."

#: admin.py:88
msgid "Stored: this number can send and receive."
msgstr "Guardado: este número puede enviar y recibir."

#: admin.py:90
msgid "Disconnect the number"
msgstr "Desconectar el número"

#: admin.py:97
#, python-format
msgid "%(count)d number disconnected."
msgid_plural "%(count)d numbers disconnected."
msgstr[0] "%(count)d número desconectado."
msgstr[1] "%(count)d números desconectados."

#: admin.py:100
msgid "Read Meta's templates again"
msgstr "Volver a leer las plantillas de Meta"

#: admin.py:104
msgid "Templates read again from Meta."
msgstr "Plantillas leídas de nuevo de Meta."

#: admin.py:107
msgid "Meta could not be read now: the templates stay as they were."
msgstr "Ahora no se ha podido leer Meta: las plantillas siguen como estaban."

#: admin.py:153
msgid "Push to the Hub now"
msgstr "Entregar al Hub ahora"

#: admin.py:157
msgid "Nothing selected waits for the Hub."
msgstr "Nada de lo elegido espera al Hub."

#: admin.py:162
#, python-format
msgid "%(delivered)d taken by the Hub, %(retried)d still waiting, %(refused)d refused by the Hub."
msgstr "%(delivered)d recogidos por el Hub, %(retried)d aún esperan y %(refused)d rechazados por el Hub."

#: apps.py:18
msgid "WhatsApp"
msgstr "WhatsApp"

#: emails.py:22
#, python-format
msgid "Action needed: connect WhatsApp again (%(number)s)"
msgstr "Hay que actuar: vuelve a conectar WhatsApp (%(number)s)"

#: emails.py:25
#, python-format
msgid "The permission that lets ERPlora send and receive WhatsApp messages with %(number)s for «%(business)s» is about to expire, and Meta did not let us renew it."
msgstr "El permiso que nos deja enviar y recibir mensajes de WhatsApp con %(number)s en «%(business)s» está a punto de caducar, y Meta no nos ha dejado renovarlo."

#: emails.py:30
msgid "Until you connect it again, your customers' WhatsApp messages will not reach your Hub."
msgstr "Hasta que lo vuelvas a conectar, los mensajes de WhatsApp de tus clientes no llegarán a tu Hub."

#: emails.py:32
#, python-format
msgid "It takes a minute: open your Hub, go to WhatsApp and connect your number again: %(url)s"
msgstr "Es un minuto: entra en tu Hub, ve a WhatsApp y vuelve a conectar tu número: %(url)s"

