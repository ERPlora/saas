#: templates/admin/assistant/aiprovider/models.html:51
msgid "Save the choice"
msgstr "Guardar la elección"

#: templates/admin/assistant/airoutingpolicy/policy.html:16
msgid "The model that answers every turn of the assistant, and the one that answers when its provider fails or cannot be used."
msgstr "El modelo que contesta cada turno del asistente, y el que contesta cuando su proveedor falla o no se puede usar."

#: templates/admin/assistant/airoutingpolicy/policy.html:17
msgid "The model that answers is off or its provider is: choose another one."
msgstr "El modelo que contesta está apagado o lo está su proveedor: elige otro."

#: templates/admin/assistant/airoutingpolicy/policy.html:18
msgid "The fallback model is off or its provider is: choose another one."
msgstr "El modelo de reserva está apagado o lo está su proveedor: elige otro."

#: templates/admin/assistant/airoutingpolicy/policy.html:19
#: templates/admin/assistant/airoutingpolicy/try.html:27
msgid "No model can answer yet: add a provider with its key and choose its models."
msgstr "Todavía no puede contestar ningún modelo: añade un proveedor con su clave y elige sus modelos."

#: templates/admin/assistant/airoutingpolicy/policy.html:34
msgid "Fallback model"
msgstr "Modelo de reserva"

#: templates/admin/assistant/airoutingpolicy/policy.html:43
#, python-format
msgid "Last changed by %(who)s on %(when)s."
msgstr "Último cambio de %(who)s el %(when)s."

#: templates/admin/assistant/airoutingpolicy/policy.html:47
msgid "Save"
msgstr "Guardar"

#: templates/admin/assistant/airoutingpolicy/try.html:26
msgid "Send one message to one model and watch its answer arrive, with its tokens, its time and its cost, before choosing it. No business, quota nor conversation is touched, and the try stays in the audit trail without the message."
msgstr "Envía un mensaje a un modelo y mira cómo llega su respuesta, con sus tokens, su tiempo y su coste, antes de elegirlo. No se toca ningún negocio, cupo ni conversación, y la prueba queda en el registro de auditoría sin el mensaje."

#: templates/admin/assistant/airoutingpolicy/try.html:41
msgid "Message"
msgstr "Mensaje"

#: templates/admin/assistant/airoutingpolicy/try.html:47
msgid "Tools"
msgstr "Herramientas"

#: templates/admin/assistant/airoutingpolicy/try.html:50
msgid "Optional: the tools the model may ask for, written as in the example, each with its name."
msgstr "Opcional: las herramientas que el modelo puede pedir, escritas como en el ejemplo, cada una con su nombre."

#: templates/admin/assistant/airoutingpolicy/try.html:54
msgid "Send"
msgstr "Enviar"

#: templates/admin/assistant/airoutingpolicy/try.html:58
msgid "Sending…"
msgstr "Enviando…"

#: templates/admin/assistant/airoutingpolicy/try.html:59
