{
  "extends": "./packages/ui/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": { "qrcode": ["./frontend/qrcode.d.ts"] }
  },
  "include": [
    "frontend/**/*",
    "accounts/frontend/**/*",
    "hubs/frontend/**/*",
    "billing/frontend/**/*",
    "fiscal/frontend/**/*",
    "packages/ui/src/shell/shims.d.ts"
  ],
  "exclude": ["frontend/dist", "**/*.test.ts", "**/__tests__/**"]
}
