msgstr "El plan está cancelado, y sus módulos con él: mantén el plan primero."

#: services.py:2069
msgid ""
"The payment service did not confirm the change. Nothing was charged; try "
"again."
msgstr ""
"El servicio de pagos no ha confirmado el cambio. No se ha cobrado nada; "
