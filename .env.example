# Local development of the SaaS: copy to saas-next/.env (never commit .env). config/settings.py
# reads only the process environment and this repo's .env, never a .env further up the tree.
# Production sets every value from Secrets Manager and the task definition.

# Off by default (production). On, the rest of the settings fall back to local defaults: no
# SECRET_KEY, INTERNAL_SHARED_SECRET or Google credentials are required.
DEBUG=True

# The root compose.yaml of erplora-next (database `saas`).
DB_NAME=saas
DB_USER=hub
DB_PASSWORD=hub
DB_HOST=127.0.0.1
DB_PORT=5432
# Seconds a dead database is waited for, per connection attempt and for a pooled connection, so
# /readyz answers 503 before the health checks give up (psycopg alone: 30 s). Default shown.
# DB_CONNECT_TIMEOUT=5

# hub-next signs POST /internal/auth/redeem with it: the same value on both sides.
INTERNAL_SHARED_SECRET=local-internal-shared-secret
# Where the one-time code is posted ({slug} = the hub's slug) and the staff's Hub admin callback.
HUB_CALLBACK_TEMPLATE=http://{slug}.localhost:8000/auth/callback
HUB_ADMIN_CALLBACK_URL=http://hubs.localhost:8000/auth/callback

# «Continue with Google»: OAuth client («Web application»), redirect URI
# http://localhost:8001/auth/google/callback/. Empty = the button is hidden (`check` says so).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Second factor (TOTP + recovery codes); off in phase 1.
ACCOUNTS_MFA_ENABLED=false

# Production only (the task definition sets them; aws README, «Contrato app ↔ infra»). Commented
# out here: each one is shown with its default, and the local values need none of them.
# Aurora over TLS with the RDS bundle in the image, and the task's name in pg_stat_activity. Unset =
# not passed to libpq (the local Postgres has no TLS).
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem
# DB_APPLICATION_NAME=saas
# Shared cache (rediss:// with TLS). Empty = this process's memory.
# VALKEY_URL=
# HSTS: one year without DEBUG (0 with it); every subdomain and the preload list are opt-in.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# Console log level (CloudWatch reads stdout).
# LOG_LEVEL=INFO
# Mail: with DEBUG a file per mail in saas-next/.mail/ (EMAIL_FILE_PATH), where the code of every
# password sign-in is read; without it the SES API in SES_REGION (ECS sets eu-west-1), signed by the
# task role (no static keys), or SMTP with the EMAIL_* values when it is empty. EMAIL_BACKEND overrides
# both (the console: django.core.mail.backends.console.EmailBackend).
# SES_REGION=
# EMAIL_FILE_PATH=.mail
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@erplora.com
# Region of the platform: CloudWatch, where `report_seal_expiry` publishes (the task role signs).
# AWS_REGION=eu-south-2
# The fiscal seal's two .p12 slots (`saas` and `saas-cron`), base64 and password. Empty = an empty
# slot: `report_seal_expiry` publishes nothing and never calls AWS.
# FISCAL_SEAL_CURRENT_P12_BASE64=
# FISCAL_SEAL_CURRENT_PASSWORD=
# FISCAL_SEAL_NEXT_P12_BASE64=
# FISCAL_SEAL_NEXT_PASSWORD=
