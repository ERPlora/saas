{
  "name": "saas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --build && tsc --noEmit -p tests/e2e",
    "lint": "eslint .",
    "gen:public-icons": "node scripts/gen-public-icons.mjs",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "e2e:headed": "E2E_HEADED=1 playwright test -c tests/e2e/playwright.config.ts",
    "e2e:ci": "CI=1 playwright test -c tests/e2e/playwright.config.ts",
    "qa:probes": "node tests/e2e/qa-probes.ts"
  },
  "dependencies": {
    "@erplora/ui": "workspace:*",
    "@ionic/core": "8.8.9",
    "@ionic/vue": "8.8.9",
    "mermaid": "^12.2.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.13"
  }
}
