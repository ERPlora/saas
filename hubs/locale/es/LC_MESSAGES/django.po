#, python-format
msgid ""
"%(business)s: its clock is advancing to %(date)s; Stripe tells what happens "
"by its events."
msgstr ""
"%(business)s: su reloj avanza hasta el %(date)s; Stripe avisa de lo que "
"pase con sus eventos."

