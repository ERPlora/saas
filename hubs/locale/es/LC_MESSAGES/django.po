#, python-format
msgid ""
"%(count)d session end(s) still pending: the Hub is away or refused it; "
"reconcile_hub_states retries it."
msgstr ""
"%(count)d cierre(s) de sesiones siguen pendientes: el Hub no responde o lo "
"rechazó; reconcile_hub_states lo reintenta."

