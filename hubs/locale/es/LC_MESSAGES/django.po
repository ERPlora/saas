#: queries.py:160
msgid "This business does not exist or you have no access to it."
msgstr "Este negocio no existe o no tienes acceso a él."

#: queries.py:183
msgid "Your role in this business does not allow it."
msgstr "Tu rol en este negocio no lo permite."

#: schemas.py:120
msgid "Choose one of the countries ERPlora serves."
msgstr "Elige uno de los países en los que está ERPlora."

#: schemas.py:127
msgid "Enter a valid email address."
msgstr "Escribe un correo electrónico válido."

#: schemas.py:135
msgid "Enter a path of the business, starting with /."
msgstr "Escribe una ruta del negocio que empiece por /."

#: schemas.py:143
msgid "Choose a valid time zone."
msgstr "Elige una zona horaria válida."

#: services.py:120 services.py:415
msgid "This business was deleted."
msgstr "Este negocio se ha eliminado."

#: services.py:143
msgid "Businesses cannot be created right now. Try again in a few minutes."
msgstr ""
"Ahora mismo no se pueden crear negocios. Inténtalo dentro de unos minutos."

#: services.py:149 services.py:599
msgid "This address belongs to ERPlora's staff and cannot join a business."
msgstr ""
"Esta dirección es del equipo de ERPlora y no puede unirse a un negocio."

#: services.py:178
msgid ""
"You already have a free business. Change its plan to create another one."
msgstr "Ya tienes un negocio gratuito. Cambia su plan para crear otro."

#: services.py:216
msgid ""
"Use only lowercase letters, digits and hyphens, without a hyphen at the "
"start or the end."
msgstr ""
"Usa solo minúsculas, dígitos y guiones, sin guion al principio ni al final."

#: services.py:218
#, python-format
msgid "Use at least %(min)d characters."
msgstr "Usa al menos %(min)d caracteres."

#: services.py:219
#, python-format
msgid "Use at most %(max)d characters."
msgstr "Usa como mucho %(max)d caracteres."

#: services.py:220
msgid "The address cannot start with “xn--”."
msgstr "La dirección no puede empezar por «xn--»."

#: services.py:230 services.py:237
msgid "This address is reserved. Choose another one."
msgstr "Esta dirección está reservada. Elige otra."

#: services.py:235 services.py:316 services.py:922
msgid "Invalid payload"
msgstr "Los datos enviados no son válidos."

#: services.py:245
msgid "This address is taken. Choose another one."
msgstr "Esta dirección ya está ocupada. Elige otra."

#: services.py:317
msgid "Type the name of the business to delete it."
msgstr "Escribe el nombre del negocio para eliminarlo."

#: services.py:377
msgid "This business is not deleted."
msgstr "Este negocio no está eliminado."

#: services.py:381
msgid "This business was erased for good and cannot be recovered."
msgstr "Este negocio se borró para siempre y no se puede recuperar."

#: services.py:410
msgid "This business is still being prepared."
msgstr "Este negocio aún se está preparando."

#: services.py:413
msgid "This business is suspended until its payment is settled."
msgstr "Este negocio está suspendido hasta que se resuelva el pago."

#: services.py:443
msgid "Confirm it is you with your authenticator app to open the business."
msgstr ""
"Confirma que eres tú con tu app de autenticación para abrir el negocio."

#: services.py:482
msgid "Only the Hub reports a business ready."
msgstr "Solo el Hub avisa de que un negocio está listo."

#: services.py:504
msgid "This member does not exist or you have no access to it."
msgstr "Este miembro no existe o no tienes acceso a él."

#: services.py:529
msgid "You cannot change your own membership."
msgstr "No puedes cambiar tu propia pertenencia."

#: services.py:531 services.py:588
msgid "You cannot manage a member whose role is equal to or above yours."
msgstr "No puedes gestionar a un miembro con un rol igual o superior al tuyo."

#: services.py:533 services.py:575
msgid "You cannot hand out a role equal to or above yours."
msgstr "No puedes dar un rol igual o superior al tuyo."

#: services.py:542
#, python-format
msgid "This plan covers %(cap)s people and they are all taken."
msgstr "Este plan cubre %(cap)s personas y ya están todas."

msgid ""
"This business has no seat left on its plan. Ask whoever invited you to free "
"one or to change the plan."
msgstr ""
"Este negocio no tiene plazas libres en su plan. Pide a quien te invitó que "
"libere una o que cambie de plan."

#: services.py:581
#, python-format
msgid "%(email)s is already on this business."
msgstr "%(email)s ya está en este negocio."

#: services.py:584
#, python-format
msgid "%(email)s already has an invitation waiting. Resend it instead."
msgstr "%(email)s ya tiene una invitación pendiente. Reenvíala."

#: services.py:639
msgid "This person has not answered yet: cancel the invitation."
msgstr "Esta persona aún no ha respondido: cancela la invitación."

#: services.py:655
msgid "This person already answered the invitation."
msgstr "Esta persona ya respondió a la invitación."

#: services.py:699
msgid "This invitation does not exist or is no longer yours to answer."
msgstr "Esta invitación no existe o ya no te corresponde responderla."

#: services.py:711
msgid "This invitation expired. Ask whoever invited you to send it again."
msgstr ""
"Esta invitación ha caducado. Pide a quien te invitó que te la vuelva a "
"enviar."

#: services.py:770
msgid ""
"Invite this person to the business first: it can only go to somebody already "
"on it."
msgstr ""
"Invita antes a esta persona al negocio: solo se puede traspasar a alguien "
"que ya esté en él."

#: services.py:774
msgid "You already own this business."
msgstr "Ya eres el propietario de este negocio."

#: services.py:779
msgid "There is already a transfer of this business waiting for an answer."
msgstr "Ya hay un traspaso de este negocio esperando respuesta."

#: services.py:807
msgid "This transfer does not exist or is not yours to answer."
msgstr "Este traspaso no existe o no te corresponde responderlo."

#: services.py:815
msgid "This transfer was already answered."
msgstr "Este traspaso ya se respondió."

#: services.py:817
msgid "This transfer expired. Ask the owner to send it again."
msgstr "Este traspaso ha caducado. Pide al propietario que lo vuelva a enviar."

#: services.py:835
msgid "You are no longer on this business."
msgstr "Ya no estás en este negocio."

#: services.py:838
msgid ""
"This business already changed hands: ask its current owner to transfer it."
msgstr ""
"Este negocio ya cambió de manos: pide a su propietario actual que lo "
"traspase."

#: services.py:922
msgid "Enter a valid tax ID for the country of the payer."
msgstr "Escribe un NIF válido para el país del pagador."

#: spanish_copy.py:396
#, python-format
msgid "This Spanish copy lost its accents: %(words)s."
msgstr "Este texto en español ha perdido sus tildes: %(words)s."

#: spanish_copy.py:410
#, python-format
msgid ""
"This is English (%(words)s): the Spanish column takes the translation, not "
"the copy."
msgstr ""
"Esto está en inglés (%(words)s): la columna en español lleva la traducción, "
"no la copia."

msgid ""
"The country cannot change once the business is ready: its invoices belong "
"to one country."
msgstr ""
"El país no se puede cambiar cuando el negocio ya está listo: sus facturas "
"son de un solo país."

msgid "Only the platform records the Hub's answers."
msgstr "Solo la plataforma registra las respuestas del Hub."

#: services.py (hubs.invitation.accept, L1-A2)
msgid "Confirm your email address before accepting the invitation."
msgstr "Confirma tu correo electrónico antes de aceptar la invitación."

#: services.py (hubs.business.notify_people, L1-A2)
msgid "Only the platform tells the people of a business."
msgstr "Solo la plataforma avisa a las personas de un negocio."

