#: emails.py:35
#, python-format
msgid "%(who)s invited you to join %(business)s on ERPlora as %(role)s."
msgstr ""
"%(who)s te ha invitado a unirte a %(business)s en ERPlora como %(role)s."

#: emails.py:46
#, python-format
msgid "Accept the invitation: %(url)s"
msgstr "Acepta la invitación: %(url)s"

#: emails.py:50
#, python-format
msgid "The invitation expires on %(date)s."
msgstr "La invitación caduca el %(date)s."

#: emails.py:57
#, python-format
msgid ""
"You do not have an ERPlora account yet: sign in with Google with this "
"address, or set a password here: %(url)s"
msgstr ""
"Aún no tienes cuenta en ERPlora: entra con Google con esta dirección o crea "
"una contraseña aquí: %(url)s"

#: emails.py:62
#, python-format
msgid "%(who)s invited you to %(business)s"
msgstr "%(who)s te ha invitado a %(business)s"

#: emails.py:72
#, python-format
msgid "%(who)s wants to hand %(business)s over to you"
msgstr "%(who)s quiere traspasarte %(business)s"

#: emails.py:77
#, python-format
msgid "%(who)s offers you the ownership of %(business)s on ERPlora."
msgstr "%(who)s te ofrece la propiedad de %(business)s en ERPlora."

#: emails.py:80
#, python-format
msgid "Accept or decline it before %(date)s: %(url)s"
msgstr "Acéptala o recházala antes del %(date)s: %(url)s"

#: emails.py:87
msgid ""
"The billing does not move with the business: whoever pays for it today keeps "
"paying until they change it."
msgstr ""
"La facturación no cambia con el negocio: quien lo paga hoy lo sigue pagando "
"hasta que lo cambie."

#: emails.py:96
#, python-format
msgid "%(who)s now owns %(business)s"
msgstr "%(who)s ya es propietario de %(business)s"

#: emails.py:102
#, python-format
msgid ""
"%(who)s accepted the ownership of %(business)s. You stay on it as an "
"administrator."
msgstr ""
"%(who)s ha aceptado la propiedad de %(business)s. Tú sigues en él como "
"administrador."

#: emails.py:107
#, python-format
msgid ""
"The billing did not move: the invoices still go to the same payer until it "
"is changed in %(url)s."
msgstr ""
"La facturación no ha cambiado: las facturas siguen yendo al mismo pagador "
"hasta que se cambie en %(url)s."

#: emails.py:117
#, python-format
msgid "%(business)s was deleted"
msgstr "%(business)s se ha eliminado"

#: emails.py:119
#, python-format
msgid "%(business)s was deleted and no longer opens."
msgstr "%(business)s se ha eliminado y ya no se abre."

#: emails.py:122
#, python-format
msgid ""
"You can recover it until %(date)s from %(url)s. After that date it is erased "
"for good."
msgstr ""
"Puedes recuperarlo hasta el %(date)s desde %(url)s. Después de esa fecha se "
"borra para siempre."

