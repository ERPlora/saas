#, python-format
msgid "%(count)d business(es) up to date in the Hub."
msgstr "%(count)d negocio(s) al día en el Hub."

#: admin.py:194
#, python-format
msgid ""
"%(count)d business(es) still owed: the Hub is away or refused it (see its "
