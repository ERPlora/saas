msgid "End the sessions in the Hub now"
msgstr "Cerrar ya las sesiones en el Hub"

#: admin.py:254
#, python-format
msgid "%(count)d session end(s) delivered."
msgstr "%(count)d cierre(s) de sesiones entregado(s)."

