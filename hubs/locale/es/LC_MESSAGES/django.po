#: emails.py:38
#, python-format
msgid "%(who)s invited you to join %(business)s on ERPlora as %(role)s."
msgstr ""
"%(who)s te ha invitado a unirte a %(business)s en ERPlora como %(role)s."

#: emails.py:49
#, python-format
msgid "Accept the invitation: %(url)s"
msgstr "Acepta la invitación: %(url)s"

#: emails.py:53
#, python-format
msgid "The invitation expires on %(date)s."
msgstr "La invitación caduca el %(date)s."

#: emails.py:60
#, python-format
msgid ""
"You do not have an ERPlora account yet: sign in with Google with this "
"address, or set a password here: %(url)s"
msgstr ""
"Aún no tienes cuenta en ERPlora: entra con Google con esta dirección o crea "
"una contraseña aquí: %(url)s"

#: emails.py:66
#, python-format
msgid "%(who)s invited you to %(business)s"
msgstr "%(who)s te ha invitado a %(business)s"

#: emails.py:76
#, python-format
msgid "%(who)s wants to hand %(business)s over to you"
msgstr "%(who)s quiere traspasarte %(business)s"

#: emails.py:81
#, python-format
msgid "%(who)s offers you the ownership of %(business)s on ERPlora."
msgstr "%(who)s te ofrece la propiedad de %(business)s en ERPlora."

#: emails.py:84
#, python-format
msgid "Accept or decline it before %(date)s: %(url)s"
msgstr "Acéptala o recházala antes del %(date)s: %(url)s"

#: emails.py:91
msgid ""
"The billing does not move with the business: whoever pays for it today keeps "
"paying until they change it."
msgstr ""
"La facturación no cambia con el negocio: quien lo paga hoy lo sigue pagando "
"hasta que lo cambie."

#: emails.py:100
#, python-format
msgid "%(who)s now owns %(business)s"
msgstr "%(who)s ya es propietario de %(business)s"

#: emails.py:106
#, python-format
msgid ""
"%(who)s accepted the ownership of %(business)s. You stay on it as an "
"administrator."
msgstr ""
"%(who)s ha aceptado la propiedad de %(business)s. Tú sigues en él como "
"administrador."

#: emails.py:111
#, python-format
msgid ""
"The billing did not move: the invoices still go to the same payer until it "
"is changed in %(url)s."
msgstr ""
"La facturación no ha cambiado: las facturas siguen yendo al mismo pagador "
"hasta que se cambie en %(url)s."

#: emails.py:125
#, python-format
msgid "%(business)s was deleted"
msgstr "%(business)s se ha eliminado"

#: emails.py:127
#, python-format
msgid "%(business)s was deleted and no longer opens."
msgstr "%(business)s se ha eliminado y ya no se abre."

#: emails.py:129
#, python-format
msgid ""
"It had been suspended for %(days)d days because an invoice was not paid."
msgstr "Llevaba %(days)d días suspendido porque una factura no se pagó."

#: emails.py:135
#, python-format
msgid ""
"You can recover it until %(date)s from %(url)s. After that date it is erased "
"for good."
msgstr ""
"Puedes recuperarlo hasta el %(date)s desde %(url)s. Después de esa fecha se "
"borra para siempre."

#: emails.py:149
#, python-format
msgid "%(business)s is ready"
msgstr "%(business)s ya está listo"

#: emails.py:151
#, python-format
msgid "%(business)s is ready: open it and start selling."
msgstr "%(business)s ya está listo: ábrelo y empieza a vender."

#: emails.py:153
#, python-format
msgid "Open it: %(url)s"
msgstr "Ábrelo: %(url)s"

#: emails.py:154
#, python-format
msgid "Manage it from the panel: %(url)s"
msgstr "Gestiónalo desde el panel: %(url)s"

#: emails.py:165
#, python-format
msgid "Last notice: %(business)s will be deleted on %(date)s"
msgstr "Último aviso: %(business)s se eliminará el %(date)s"

#: emails.py:167
#, python-format
msgid "%(business)s is still suspended"
msgstr "%(business)s sigue suspendido"

#: emails.py:170
#, python-format
msgid "%(business)s is still suspended because an invoice was not paid."
msgstr "%(business)s sigue suspendido porque una factura no se pagó."

#: emails.py:171
#, python-format
msgid "If it is not paid, the business will be deleted on %(date)s."
msgstr "Si no se paga, el negocio se eliminará el %(date)s."

#: emails.py:172
msgid "After that you can still recover it for 90 days, on the Free plan."
msgstr "Después aún podrás recuperarlo durante 90 días, en el plan Gratis."

#: emails.py:174
#, python-format
msgid "Pay it from Billing and it works again at once: %(url)s"
msgstr "Págala desde Facturación y vuelve a funcionar al momento: %(url)s"

