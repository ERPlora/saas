#: admin.py:147
msgid "Attach its payer to a Stripe test clock (test keys only)"
msgstr ""
"Atar su pagador a un reloj de prueba de Stripe (solo claves de prueba)"

#: admin.py:158
#, python-format
msgid "%(business)s: its payer is a new Stripe customer on clock %(clock)s."
msgstr ""
"%(business)s: su pagador es un cliente nuevo de Stripe en el reloj "
"%(clock)s."

